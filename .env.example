# Copy to .env and fill in, or set these in your host's dashboard.
# Nothing here is needed to run locally - the defaults are your own PostgreSQL.

# Managed hosts give you one of these. It replaces every PG* setting below.
# DATABASE_URL=postgresql://user:password@host.neon.tech/postgres?sslmode=require

# Or set the pieces individually.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=
# PGDATABASE=postgres
# PGSSLMODE=require

# Databases offered in the dropdown, in order. Empty = show every database.
# VISIBLE_DATABASES=sarawak basin,subbasin_gis

# Let visitors type raw SELECT statements. Fine locally, switch off in public.
# ALLOW_RAW_SQL=0

# Signs the download links. Set a fixed value so links survive a restart.
# SECRET_KEY=

# --- connections -----------------------------------------------------------
# Connections kept open per database, and how long a caller waits for a free
# one. Six suits the four gunicorn threads plus a streaming download.
# DB_POOL_MAX=6
# DB_POOL_WAIT=10
# CONNECT_TIMEOUT=10

# Any single query that runs longer than this is cancelled.
# STATEMENT_TIMEOUT_MS=20000

# --- schema cache ----------------------------------------------------------
# Read at startup in the background and kept on disk, so a restart does not
# make the first visitor wait for a full scan.
# SCHEMA_CACHE_FILE=/tmp/database_chat_schema.json
# SCHEMA_TTL_SECONDS=0        # 0 = never expires; refresh deliberately
# WARM_SCHEMA=1               # 0 skips the background warm-up

# Set this and POST /api/refresh with an X-Refresh-Token header to re-read the
# schema after the data changes. Unset, that endpoint does not exist.
# REFRESH_TOKEN=

# --- limits ----------------------------------------------------------------
# Per visitor, per minute. 0 switches a limit off.
# ASK_LIMIT_PER_MINUTE=40
# EXPORT_LIMIT_PER_MINUTE=10

# Refuse whole-table downloads larger than this. 0 = no ceiling.
# MAX_EXPORT_ROWS=250000

# Where questions the engine could not answer are recorded, one JSON line each.
# MISS_LOG=/tmp/database_chat_misses.log

# --- map -------------------------------------------------------------------
# How much detail to drop before sending shapes to the browser, in degrees
# (0.0005 is roughly 55 m). Downloads always keep full detail.
# MAP_SIMPLIFY_DEGREES=0.0005
# MAP_MAX_FEATURES=5000
