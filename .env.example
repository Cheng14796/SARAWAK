# Copy to .env and fill in, or set these in your host's dashboard.
# Nothing here is needed to run locally - the defaults are your own PostgreSQL.

# Managed hosts give you one of these. It replaces every PG* setting below.
# DATABASE_URL=postgresql://user:password@host.neon.tech/postgres?sslmode=require

# Or set the pieces individually.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=
# PGDATABASE=postgres
# PGSSLMODE=require

# Databases offered in the dropdown, in order. Empty = show every database.
# VISIBLE_DATABASES=sarawak basin,subbasin_gis

# Let visitors type raw SELECT statements. Fine locally, switch off in public.
# ALLOW_RAW_SQL=0

# Signs the download links. Set a fixed value so links survive a restart.
# SECRET_KEY=
